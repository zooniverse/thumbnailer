apiVersion: apps/v1
kind: Deployment
metadata:
  name: thumbnailer-staging
  labels:
    app: thumbnailer-staging
spec:
  replicas: 1
  selector:
    matchLabels:
      app: thumbnailer-staging
  template:
    metadata:
      labels:
        app: thumbnailer-staging
    spec:
      containers:
        - name: thumbnailer-staging-nginx
          image: ghcr.io/zooniverse/thumbnailer:__IMAGE_TAG__
          ports:
            - containerPort: 80
          resources:
            requests:
              cpu: 100m
              memory: 250Mi
            limits:
              cpu: 500m
              memory: 500Mi
          ports:
            - containerPort: 80
        - name: thumbnailer-staging-video
          image: ghcr.io/zooniverse/video-thumbnailer:__IMAGE_TAG__
          ports:
            - containerPort: 8080
          resources:
            requests:
              cpu: 100m
              memory: 128Mi
            limits:
              # Limit CPU to prevent FFmpeg from starving Nginx during spikes
              cpu: 500m
              memory: 512Mi
---
apiVersion: v1
kind: Service
metadata:
  name: thumbnailer-staging
spec:
  selector:
    app: thumbnailer-staging
  ports:
    - protocol: TCP
      port: 80
      targetPort: 80
  type: NodePort
